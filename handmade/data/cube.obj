# A unit cube centred on the origin, -0.5 to 0.5 on every axis.
#
# NOTE(yigit): Written by hand rather than exported, so that anything in the
# engine wanting a cube - light markers, a debug volume - loads it from here
# instead of carrying a vertex table in code.  Scale it at the draw.
#
# Faces are quads.  The loader triangulates with a fan, which is correct for
# any convex polygon and a quad is as convex as it gets.
#
# Wound counter-clockwise seen from OUTSIDE, matching the rest of the engine,
# so this stays correct if face culling is ever turned on.
#
# No mtllib and no usemtl: with no material named, the loader gives it material
# 0 and the 1x1 white texture, and the colour comes from whichever shader draws
# it.  That is what the lamp and outline programs want.

# 8 corners
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5

# One texture coordinate per corner of a face - the same square repeats on all
# six, which is all a marker cube needs.
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# One normal per face.  A cube has hard edges, so the corners deliberately do
# NOT share a normal - that is what keeps the faces flat instead of rounding
# the lighting across the seam.
vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

# front  +Z
f 1/1/1 2/2/1 3/3/1 4/4/1
# back   -Z
f 6/1/2 5/2/2 8/3/2 7/4/2
# left   -X
f 5/1/3 1/2/3 4/3/3 8/4/3
# right  +X
f 2/1/4 6/2/4 7/3/4 3/4/4
# top    +Y
f 4/1/5 3/2/5 7/3/5 8/4/5
# bottom -Y
f 5/1/6 6/2/6 2/3/6 1/4/6
